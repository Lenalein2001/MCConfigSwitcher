<Window x:Class="MCConfigSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:validators="clr-namespace:MCConfigSwitcher.Validators"
        mc:Ignorable="d"
        Title="MC Config Switcher" Height="640" Width="1100" MinWidth="900" MinHeight="560">
    <Grid Background="{StaticResource Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top header -->
        <Grid Grid.Row="0" Margin="16,12,16,8">
            <TextBlock Text="MC Config Switcher" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center"/>
        </Grid>

        <!-- Main content area -->
        <ScrollViewer Grid.Row="1" Margin="16,0,16,12" VerticalScrollBarVisibility="Auto">
        <Grid DataContext="{Binding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Profiles card -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Profiles" FontWeight="SemiBold" FontSize="14" Margin="0,0,8,0"/>
                        <Border Background="{StaticResource Brush.Border}" Width="1" Height="18" Margin="8,0"/>
                        <TextBlock Text="Manage list" Foreground="{StaticResource Brush.MutedText}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource Button.Primary}" Content="Add" MinWidth="85" Command="{Binding AddProfileCommand}"/>
                        <Button Style="{StaticResource Button.Base}" Content="Duplicate" MinWidth="100" Command="{Binding DuplicateProfileCommand}"/>
                        <Button Style="{StaticResource Button.Base}" Content="Delete" MinWidth="85" Command="{Binding DeleteProfileCommand}"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Editor card -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Profile editor" FontWeight="SemiBold" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" DataContext="{Binding SelectedProfile}">
                        <TextBlock Text="Name:" Width="60" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="280"/>
                    </StackPanel>

                    <!-- Target file selector -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" DataContext="{Binding SelectedProfile}">
                        <TextBlock Text="Target:" Width="60" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Targets[0].Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="340"/>
                        <Button Content="Browse" Margin="8,0,0,0" Command="{Binding DataContext.BrowseFileCommand, RelativeSource={RelativeSource AncestorType=Border}}"/>
                    </StackPanel>

                    <!-- Dynamic IP entries -->
                    <StackPanel Margin="0,12,0,0" DataContext="{Binding}">
                        <TextBlock Text="IP Addresses" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Add IP" Command="{Binding AddIpCommand}" Style="{StaticResource Button.Primary}"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding SelectedProfile.IpEntries}" Margin="0,6,0,0" MaxHeight="180">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="140" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Width="180">
                                            <TextBox.Text>
                                                <Binding Path="Address" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True" ValidatesOnExceptions="True">
                                                    <Binding.ValidationRules>
                                                        <validators:IPv4ValidationRule />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                        <Button Content="Delete" Command="{Binding DataContext.DeleteIpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Active:" Width="60" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding SelectedProfile.IpEntries}"
                                      SelectedValue="{Binding SelectedProfile.ActiveIpChoice, Mode=TwoWay}"
                                      SelectedValuePath="Name"
                                      DisplayMemberPath="Name" Width="160"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Quick actions card -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Quick Actions" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Active:" Margin="0,12,0,4" FontSize="11" Foreground="{StaticResource Brush.MutedText}"/>
                    <TextBlock Text="{Binding SelectedProfile.Name, FallbackValue='(none)'}" 
                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <Button Style="{StaticResource Button.Primary}" Content="Dry Run" Command="{Binding DryRunCommand}" ToolTip="Preview changes without modifying files"/>
                    <Button Style="{StaticResource Button.Base}" Content="Apply" Command="{Binding ApplyCommand}" ToolTip="Apply changes to target file (creates backup first)"/>
                    <Button Style="{StaticResource Button.Base}" Content="Revert" Command="{Binding RevertCommand}" ToolTip="Restore from most recent backup"/>
                    
                    <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Margin="0,16,0,0" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Logs" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LogEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Border}" 
                                                    BorderThickness="0,0,0,1" Padding="6,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat=HH:mm:ss}" 
                                                               FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Brush.MutedText}" 
                                                               Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Top">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Info">
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                                        <Setter Property="Foreground" Value="#FFA500"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                        <Setter Property="Foreground" Value="#FF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="{Binding Level}" FontWeight="Bold"/>
                                                        <Run Text=": "/>
                                                        <Run Text="{Binding Message}" Foreground="{StaticResource Brush.Text}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- Status bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem><TextBlock Text="Ready"/></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
